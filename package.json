{
  "name": "my-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:demo": "node scripts/capture-demo.mjs",
    "db:start": "node scripts/setup-local.mjs",
    "db:stop": "supabase stop",
    "db:status": "node scripts/status-local.mjs",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "setup:local": "node scripts/setup-local.mjs",
    "test:integration": "node --env-file=.env.local scripts/verify-database.mjs && node --env-file=.env.local scripts/verify-storage.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
